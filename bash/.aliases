# Git aliases
alias gc='git commit -m'
alias gi='git init'
alias ga='git add'
alias gp='git push'
alias gpo='git push -u origin main'
alias grao='git remote add origin'
alias st='git status'
alias cm='git commit -m'
alias xb='git branch -d'
alias mb='git checkout main'
alias sb='git checkout'
alias nb='git checkout -b'

# Navigation aliases
alias rfi='echo "Navigated into the root directory."; cd ~'
alias dfi='echo "Navigated into the dotfiles directory."; cd ~/developer/dotfiles'
alias nvc='echo "Navigated into the neovim config directory."; cd ~/.config/nvim'
alias dvi='echo "Navigated into the developer directory."; cd ~/developer'

# File aliases
alias rmd='rmdir'
alias mk='mkdir'
alias ls='gls -a --color=auto'
alias .a='echo "Sourced aliases."; source ~/.aliases'
alias .z='echo "Sourced .bashrc."; source ~/.bashrc'
alias .b='echo "Sourced .bashrc."; source ~/.bashrc'

mkcd() {
    mkdir -p "$1"
    cd "$1"
}

# Neovim aliases
alias nv='nvim'
alias ea='nvim ~/.aliases'
alias ez='nvim ~/.bashrc'
alias eb='nvim ~/.bashrc'

# Other
alias c='clear'
alias hc='history -c'
